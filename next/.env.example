# =============================================================================
# QurbaniHat (Next.js) — Environment Variable Template
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
#   cp next/.env.example next/.env.local
# =============================================================================

# --- MongoDB (REQUIRED — Better Auth persistence) ----------------------------
# Free MongoDB Atlas cluster: https://cloud.mongodb.com
# Atlas > Connect > Drivers > copy the connection string.
# Keep the database name inside the URI or set MONGODB_DB separately.
MONGODB_URI=
MONGODB_DB=qurbanihat

# --- Better Auth (REQUIRED) --------------------------------------------------
# Signing/encryption secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Public base URL of THIS app. Better Auth uses it to build OAuth callback URLs
# and trusted origins. Never hardcode this in source code.
#
#   local development : http://localhost:3000   <- must be `localhost`, NOT 0.0.0.0
#   production/Vercel : https://qurbanihat.vercel.app
#
# NOTE: the Next.js server binds to 0.0.0.0:3000 so LAN/preview clients can reach
# it (`npm run dev`), but a browser can never open `http://0.0.0.0:3000`
# (Chrome: ERR_ADDRESS_INVALID -108). lib/app-url.ts rewrites any bind-only host
# (0.0.0.0, ::, 127.0.0.1) to `localhost` automatically, so both values are safe:
# just prefer the localhost form.
BETTER_AUTH_URL=http://localhost:3000

# Client-visible copy of the same URL (used by the Better Auth browser client).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (REQUIRED for "Continue with Google") ----------------------
# https://console.cloud.google.com/apis/credentials
#   1. Create Credentials > OAuth client ID > Web application
#   2. Authorized JavaScript origins: http://localhost:3000
#   3. Authorized redirect URIs:
#        http://localhost:3000/api/auth/callback/google      (development)
#        https://<your-domain>/api/auth/callback/google      (production)
#   4. On Vercel, set the production values as separate environment variables —
#      never overwrite them with localhost values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
