# ==================================================================
# QurbaniHat — Environment Variable Template  (SAFE placeholders)
# Copy this file to `.env.local` and replace with REAL credentials.
#   cp .env.example .env.local
# .env.local is git-ignored and must never be committed.
# ==================================================================

# --- Google Cloud OAuth 2.0  (REQUIRED for "Continue with Google") ---
# Create OAuth credentials here:
#   https://console.cloud.google.com/apis/credentials
#   1. Click "+ CREATE CREDENTIALS" > "OAuth client ID"
#   2. Application type: "Web application"
#   3. Authorized JavaScript origins:  http://localhost:3000
#   4. Authorized redirect URI:        http://localhost:3000/api/auth/callback/google
#
# GOOGLE_CLIENT_ID is public by design (the browser receives it from
# /api/auth/config) — BUT the server below rejects these placeholder
# values on purpose, so real values are required to enable login.
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET is SECRET.
# Used ONLY server-side in api/index.ts (authorization-code exchange
# at https://oauth2.googleapis.com/token). Never expose it in frontend
# code, .env.example, or any committed file.
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# --- Optional variables -------------------------------------------------
# Google AI Studio / Gemini API key (only used if Gemini features are enabled)
GEMINI_API_KEY=""

# Public deployment URL (used for sharing/linking)
APP_URL="https://your-vercel-app.vercel.app"
